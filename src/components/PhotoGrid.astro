---
import { Image } from "astro:assets";
import type { AlbumPhoto } from "../lib/albums";

interface Props {
  photos: AlbumPhoto[];
  galleryId: string;
  eagerCount?: number;
  preview?: boolean;
  albumHref?: string;
  class?: string;
}

const {
  photos,
  galleryId,
  eagerCount = 1,
  preview = false,
  albumHref,
  class: className = ""
} = Astro.props;

// Width descriptors let small screens avoid downloading desktop-size thumbnails.
const imageWidths = [320, 480, 640, 960, 1280, 1920];
const imageSizes = (photo: AlbumPhoto) => {
  const ratio = photo.image.width / photo.image.height;
  return `(min-width: 1440px) ${Math.ceil(460 * ratio)}px, (min-width: 701px) ${Math.ceil(320 * ratio)}px, (min-width: 520px) ${Math.ceil(300 * ratio)}px, calc(100vw - 20px)`;
};
---

<section
  class:list={["photo-grid", { "photo-grid--preview": preview }, className]}
  data-gallery-id={galleryId}
>
  {
    photos.map((photo, index) => (
      <a
        style={`--width: ${photo.image.width}; --height: ${photo.image.height};`}
        href={
          albumHref
            ? `${albumHref}?photo=${encodeURIComponent(photo.src)}`
            : photo.image.src
        }
        data-astro-reload={albumHref ? undefined : true}
        data-astro-prefetch="false"
        data-fancybox={albumHref ? undefined : galleryId}
        data-caption={photo.title ?? photo.alt}
        data-photo-src={photo.src}
        aria-label={photo.alt}
      >
        <Image
          format="webp"
          src={photo.image}
          alt={photo.alt}
          width={Math.min(960, photo.image.width)}
          widths={imageWidths.filter((width) => width < Math.min(1920, photo.image.width)).concat(Math.min(1920, photo.image.width))}
          sizes={`${index < eagerCount ? "" : "auto, "}${imageSizes(photo)}`}
          quality={82}
          decoding="async"
          fetchpriority={index === 0 && eagerCount > 0 ? "high" : "auto"}
          loading={index < eagerCount ? "eager" : "lazy"}
        />
      </a>
    ))
  }
</section>

<script>
  let previewObserver: ResizeObserver | undefined;

  const setupPreviews = () => {
    previewObserver?.disconnect();
    // Cropped rows must not leave invisible links in the tab order/accessibility tree.
    const updatePreview = (grid: HTMLElement) => {
      const bottom = grid.getBoundingClientRect().bottom;
      grid.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
        link.inert = bottom - link.getBoundingClientRect().top < 44;
      });
    };
    previewObserver = new ResizeObserver((entries) => {
      entries.forEach(({ target }) => updatePreview(target as HTMLElement));
    });
    document.querySelectorAll<HTMLElement>(".photo-grid--preview").forEach((grid) => {
      updatePreview(grid);
      previewObserver!.observe(grid);
    });
  };

  document.addEventListener("astro:page-load", setupPreviews);
  document.addEventListener("astro:before-swap", () => previewObserver?.disconnect());
</script>

<style>
  .photo-grid {
    --padding: var(--gutter);
    --space: 18px;
    --min-height: 240px;

    padding: 4px var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);
  }

  .photo-grid--preview {
    max-height: calc((var(--min-height) * 1.5) + (var(--space) * 2) + (var(--padding) * 2));
    overflow: hidden;
  }

  .photo-grid a {
    flex-grow: calc(var(--width) * (100000 / var(--height)));
    flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
    aspect-ratio: var(--width) / var(--height);
    background: var(--surface);
    overflow: hidden;
    opacity: 1;
    transition:
      transform 0.12s ease,
      opacity 0.2s ease,
      box-shadow 0.12s ease;
  }

  .photo-grid a img {
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .photo-grid a:hover img {
      transform: scale(1.025);
    }
  }

  .photo-grid a:focus-visible {
    outline: 3px solid var(--outline);
    outline-offset: -3px;
    z-index: 1;
    border-radius: 2px;
    box-shadow: 0 2px 4px 2px rgb(0 0 0 / 10%);
  }

  .photo-grid::after {
    content: " ";
    flex-grow: 1000000000;
  }

  @media (max-width: 700px) {
    .photo-grid {
      --space: 10px;
      --min-height: 160px;
    }
  }

  @media (min-width: 520px) and (max-width: 700px) {
    .photo-grid {
      --min-height: 230px;
    }
  }

  @media (min-width: 1440px) {
    .photo-grid {
      --space: 28px;
      --min-height: 360px;
    }
  }
</style>
